{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "agentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$"
    },
    "adapterId": {
      "type": "string",
      "enum": [
        "grok",
        "generic_mcp"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "connectionChangedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "toolDiscovery": {
      "type": "object",
      "properties": {
        "bridgeToolCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "exposedTools": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "list_delegated_work",
              "read_delegated_work",
              "claim_delegated_work",
              "propose_cleaning_time",
              "read_agent_profile",
              "declare_agent_capabilities",
              "begin_agent_probe",
              "complete_agent_probe"
            ]
          }
        },
        "method": {
          "type": "string",
          "const": "operator_report"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "serverSoftwareVersion": {
          "type": "string",
          "const": "0.2.0"
        },
        "serverToolCount": {
          "type": "number",
          "const": 8
        }
      },
      "required": [
        "bridgeToolCount",
        "exposedTools",
        "method",
        "observedAt",
        "serverSoftwareVersion",
        "serverToolCount"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "minItems": 7,
      "maxItems": 7,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "enum": [
              "mcp_tools",
              "generation_reasoning",
              "background_runs",
              "scheduled_runs",
              "native_integrations",
              "files_images",
              "reminders_notifications"
            ]
          },
          "declared": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "unknown"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "failed"
                ]
              },
              "method": {
                "type": "string",
                "enum": [
                  "server_probe",
                  "server_fixture",
                  "engine_workflow",
                  "operator_review"
                ]
              },
              "evidenceId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "scope": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "expiresAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              "latencyMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "extensionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,100}$"
              },
              "grantFingerprint": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "ownerConfirmedConversationClosed": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "status",
              "method",
              "evidenceId",
              "scope",
              "observedAt",
              "expiresAt"
            ],
            "additionalProperties": false
          },
          "status": {
            "type": "string",
            "enum": [
              "unknown",
              "declared",
              "unavailable",
              "verified",
              "failed",
              "expired"
            ]
          }
        },
        "required": [
          "capability",
          "declared",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "nativeExtensions": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "calendar",
              "guesty",
              "files",
              "notifications",
              "other"
            ]
          },
          "permissions": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "calendar.read",
                "guesty.read",
                "files.read",
                "notifications.read",
                "native.read"
              ]
            }
          }
        },
        "required": [
          "id",
          "kind",
          "permissions"
        ],
        "additionalProperties": false
      }
    },
    "grants": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "extensionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "permissions": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "calendar.read",
                "guesty.read",
                "files.read",
                "notifications.read",
                "native.read"
              ]
            }
          },
          "resourceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "extensionId",
          "permissions",
          "resourceId",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    },
    "readiness": {
      "type": "object",
      "properties": {
        "executionMode": {
          "type": "string",
          "enum": [
            "unavailable",
            "interactive",
            "scheduled",
            "autonomous"
          ]
        },
        "deadlineMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fallback": {
          "type": "string",
          "const": "engine_owned"
        },
        "productionReady": {
          "type": "boolean",
          "const": false
        },
        "autonomousScopes": {
          "maxItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "const": "cleaner.reschedule_requested"
          }
        },
        "generation": {
          "type": "string",
          "enum": [
            "synthetic_probe_verified",
            "unverified"
          ]
        },
        "appToolDiscovery": {
          "type": "string",
          "enum": [
            "unknown",
            "complete",
            "partial"
          ]
        },
        "onboardingTransport": {
          "type": "string",
          "enum": [
            "unverified",
            "mcp",
            "core_mcp_owner_http"
          ]
        },
        "missingForAutonomous": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "verified_mcp_tools",
              "verified_background_runs",
              "background_latency_within_deadline",
              "delegation_tools_unavailable"
            ]
          }
        }
      },
      "required": [
        "executionMode",
        "deadlineMs",
        "fallback",
        "productionReady",
        "autonomousScopes",
        "generation",
        "appToolDiscovery",
        "onboardingTransport",
        "missingForAutonomous"
      ],
      "additionalProperties": false
    },
    "extensions": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "calendar",
              "guesty",
              "files",
              "notifications",
              "other"
            ]
          },
          "permissions": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "calendar.read",
                "guesty.read",
                "files.read",
                "notifications.read",
                "native.read"
              ]
            }
          },
          "permissionGranted": {
            "type": "boolean"
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "unknown",
              "declared",
              "unavailable",
              "verified",
              "failed",
              "expired"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "permissions",
          "permissionGranted",
          "verificationStatus"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "tenantId",
    "agentId",
    "adapterId",
    "createdAt",
    "updatedAt",
    "capabilities",
    "nativeExtensions",
    "grants",
    "readiness",
    "extensions"
  ],
  "additionalProperties": false,
  "title": "AgentProfile readiness response"
}
