# Dedicated integration lab only; the touring and Phase 0.5 services are separate.
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY scripts ./scripts
COPY src ./src
RUN npm run build

FROM node:24-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production CLEANER_PHASE06_HOST=0.0.0.0 CLEANER_PHASE06_PORT=4336 CLEANER_PHASE06_HOME=/data/phase06
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && mkdir -p /data/phase06 && chown -R node:node /data
COPY --from=build /app/dist/cleaner-phase06.js ./dist/cleaner-phase06.js
USER node
EXPOSE 4336
CMD ["node", "dist/cleaner-phase06.js", "lab", "--live"]
