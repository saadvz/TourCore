{
  "name": "tour-core",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source self-touring tool. Requests scoped access through Durin; never controls locks directly.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "setup": "tsx src/web/server.ts",
    "setup:dev": "tsx src/web/server.ts --dev",
    "setup:web": "tsx src/web/server.ts",
    "setup:cli": "tsx src/cli/setup.ts",
    "sendblue:status": "tsx src/tools/sendblue.ts status",
    "sendblue:configure": "tsx src/tools/sendblue.ts configure",
    "sendblue:add-contact": "tsx src/tools/sendblue.ts add-contact",
    "sendblue:test": "tsx src/tools/sendblue.ts test",
    "grok:connect": "tsx src/tools/grok.ts connect",
    "grok:status": "tsx src/tools/grok.ts status",
    "grok:disconnect": "tsx src/tools/grok.ts disconnect",
    "grok:tools": "tsx src/tools/grok.ts tools",
    "hosted:owner-claim": "tsx src/install/ownerClaimCli.ts",
    "bootstrap:grok": "node scripts/bootstrap-grok.mjs --mode=GROK_MANAGED_P0",
    "bootstrap:self-hosted": "node scripts/bootstrap-grok.mjs --mode=SELF_HOSTED",
    "service:start": "tsx src/install/serviceCli.ts start",
    "service:stop": "tsx src/install/serviceCli.ts stop",
    "service:restart": "tsx src/install/serviceCli.ts restart",
    "service:status": "tsx src/install/serviceCli.ts status",
    "install:status": "tsx src/install/serviceCli.ts install-status",
    "install:link": "tsx src/install/serviceCli.ts link",
    "demo": "tsx src/demo/run.ts",
    "demo:auto": "tsx src/demo/run.ts --auto",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^5.2.1",
    "sendblue": "^3.17.0",
    "spectrum-ts": "^12.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
