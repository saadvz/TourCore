# Copy to .env (git-ignored) and fill in. Only needed for real phones via Sendblue;
# demo messaging, practice tours and the browser visitor demo need none of this.

# Sendblue API credentials (Sendblue dashboard -> API keys)
SENDBLUE_API_API_KEY=
SENDBLUE_API_API_SECRET=

# The Sendblue line Tour Core texts from, in +1XXXXXXXXXX form.
# Free sandbox: the shared sandbox number. Production: your dedicated line.
SENDBLUE_FROM_NUMBER=

# Public https address that reaches this computer (a secure tunnel during development).
# Tour Core derives PUBLIC_BASE_URL/webhooks/sendblue and PUBLIC_BASE_URL/verify/<token> from it.
PUBLIC_BASE_URL=

# Shared secret Sendblue sends with each webhook. `npm run sendblue:configure` creates one if empty.
SENDBLUE_WEBHOOK_SECRET=

# Optional: a language model to help read texts the built-in rules can't place
# ("yo we're parked by the mailbox thing"). It only classifies what the visitor
# means; Tour Core's own rules still decide every door. Leave blank for rules only.
# Any OpenAI-compatible chat API works, e.g.
#   xAI (Grok):  https://api.x.ai/v1            model e.g. grok-4
#   OpenAI:      https://api.openai.com/v1      model e.g. gpt-4.1-mini
#   Anthropic:   https://api.anthropic.com/v1/  model e.g. claude-haiku-4-5
TOURCORE_INTENT_MODEL_URL=
TOURCORE_INTENT_MODEL_KEY=
TOURCORE_INTENT_MODEL=
# How long to wait for the model before falling back to the rules (default 4000).
TOURCORE_INTENT_MODEL_TIMEOUT_MS=
