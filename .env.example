# Copy to .env (git-ignored) and fill in. Developer path only (README, Path C).
# Grok-managed and self-hosted installs don't need a .env: credentials go in on Tour Core's
# secure setup page (http://localhost:4321/install), which takes precedence over these values.
# Demo messaging, practice tours and the browser visitor demo need none of this.

# LOCAL_DEVELOPER (default), GROK_MANAGED_P0, SELF_HOSTED, or HOSTED_RAILWAY_P0.
# HOSTED_RAILWAY_P0 is set on our Railway service, not in a landlord's .env.
# See docs/deployment.md. Landlords do not create a Railway project.
TOURCORE_DEPLOYMENT_MODE=

# Records folder. Local development defaults to ./tourcore-data and does not
# require this. HOSTED_RAILWAY_P0 must set it to the Railway volume (usually /data).
# The hosted process refuses to start if this path is missing or is not on a
# mounted volume (the container disk is wiped on deploy).
TOURCORE_HOME=

# Restore upload cap in bytes. Default is 50 MB (50_000_000). A real backup is
# about 10 MB. An upload over the cap returns 413 and states the limit.
# An invalid value keeps the default.
# TOURCORE_RESTORE_UPLOAD_MAX_BYTES=

# Railway sets this to the volume mount (usually /data). When it is present,
# TOURCORE_HOME must be inside that path. Do not set this in a local .env.
# RAILWAY_VOLUME_MOUNT_PATH=

# HOSTED_RAILWAY_P0 only. Set to 1 to start even if TOURCORE_HOME is not on a
# persistent volume (disposable demos). Data will be lost on the next deploy.
# Local `npm run setup` does not use this guard.
TOURCORE_ALLOW_EPHEMERAL_STORAGE=

# Set which adapter answers visitors. Leave empty until you choose.
# sendblue, twilio, photon, or local (QA loopback; no real texts). If this is empty and Sendblue is already configured, Tour Core keeps Sendblue.
TOURCORE_MESSAGING_PROVIDER=

# Optional reserved number for the local QA loopback. Defaults to +15555550123.
TOURCORE_LOCAL_FROM_NUMBER=

# keyword_confirm, provider_default, or disabled. STOP, START, and HELP still apply when messaging is on.
TOURCORE_SMS_CONSENT_MODE=

# Twilio. Leave secrets empty. The phone number below is a reserved example, not a real line.
TOURCORE_TWILIO_ACCOUNT_SID=
TOURCORE_TWILIO_AUTH_TOKEN=
TOURCORE_TWILIO_PHONE_NUMBER=+15555550123

# Photon / Spectrum cloud. Leave secrets empty. Do not put a project id or line id here.
TOURCORE_PHOTON_PROJECT_ID=
TOURCORE_PHOTON_PROJECT_SECRET=
TOURCORE_PHOTON_PHONE_NUMBER=
TOURCORE_PHOTON_WEBHOOK_SECRET=
TOURCORE_PHOTON_WEBHOOK_STANDARD_SECRET=

# Sendblue API credentials (Sendblue dashboard -> API keys)
SENDBLUE_API_API_KEY=
SENDBLUE_API_API_SECRET=

# The Sendblue line Tour Core texts from, in +1XXXXXXXXXX form.
# Free sandbox: the shared sandbox number. Production: your dedicated line.
SENDBLUE_FROM_NUMBER=

# Public https address that reaches this computer (a secure tunnel during development).
# Tour Core derives PUBLIC_BASE_URL/webhooks/sendblue and PUBLIC_BASE_URL/verify/<token> from it.
# Compliance pages at /TourCore/privacy, /TourCore/terms, and /TourCore/sms build absolute links from this value.
# Example: https://example.com
# Do not hardcode a hosting provider. When the public address changes, set this to the new https origin.
PUBLIC_BASE_URL=

# Public, non-secret values for compliance pages and HELP replies. Not credentials.
# The deployer supplies these. Tour Core does not invent a legal entity, support address, or SMS number.
# Public program name. Defaults to Tour Core when empty.
TOURCORE_PUBLIC_BRAND_NAME=Tour Core
# Legal operator of this deployment. Example: Example Property Company LLC
# Leave empty until you set it. Compliance pages will warn instead of inventing a name.
TOURCORE_PUBLIC_LEGAL_NAME=
# Public SMS number visitors text, in E.164. Example: +15555550123
# Shown on /TourCore/sms. Separate from SENDBLUE_FROM_NUMBER so a sandbox line is never published by accident.
TOURCORE_PUBLIC_SMS_NUMBER=
# Public support address for privacy, terms, and the SMS page. Example: support@example.com
# HELP replies do not use this; they list the optional visitor help number, then reply here.
TOURCORE_PUBLIC_CONTACT_EMAIL=support@example.com

# Shared secret Sendblue sends with each webhook. `npm run sendblue:configure` creates one if empty.
SENDBLUE_WEBHOOK_SECRET=

# Grok Bot operator console at PUBLIC_BASE_URL/mcp. Default: OAuth. Grok signs in and you
# click Allow on this computer (http://localhost:4321/grok). Nothing to paste into Grok.
# `static` is for development only: /mcp then accepts just TOURCORE_OPERATOR_TOKEN and OAuth is off.
TOURCORE_MCP_AUTH_MODE=
# Static mode only. `npm run grok:connect -- --static` creates it. Never paste it into a chat.
TOURCORE_OPERATOR_TOKEN=
# Extra hosts OAuth clients may return to (comma-separated). grok.com, x.ai and x.com are always allowed.
TOURCORE_OAUTH_REDIRECT_HOSTS=
# P0 Grok testing only: also accept Cursor's two known legacy callbacks, as exact strings
# (cursor://anysphere.cursor-mcp/oauth/callback, https://www.cursor.com/agents/mcp/oauth/callback).
# Grok Bot's current registration includes them. Leave blank (strict) otherwise. See docs/grok-manual-test.md.
TOURCORE_GROK_LEGACY_OAUTH_COMPAT=

# Operator updates (the Tour Core Operator Updates Grok Routine). Prefer the secure setup page;
# set these here only for local development. Never paste them into a chat.
TOURCORE_GROK_ROUTINE_URL=
TOURCORE_GROK_ROUTINE_KEY=

# Where Grok clones Tour Core from (the public open-source repository). Read by the
# Install Tour Core skill on Grok's cloud computer; never a private repository.
TOURCORE_REPO_URL=

# Optional: a language model to help read texts the built-in rules can't place
# ("yo we're parked by the mailbox thing"). It only classifies what the visitor
# means; Tour Core's own rules still decide every door. Leave blank for rules only.
# Any OpenAI-compatible chat API works, e.g.
#   xAI (Grok):  https://api.x.ai/v1            model e.g. grok-4
#   OpenAI:      https://api.openai.com/v1      model e.g. gpt-4.1-mini
#   Anthropic:   https://api.anthropic.com/v1/  model e.g. claude-haiku-4-5
TOURCORE_INTENT_MODEL_URL=
TOURCORE_INTENT_MODEL_KEY=
TOURCORE_INTENT_MODEL=
# How long to wait for the model before falling back to the rules (default 4000).
TOURCORE_INTENT_MODEL_TIMEOUT_MS=
